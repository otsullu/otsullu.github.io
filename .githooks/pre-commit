#!/bin/sh
# Auto-stamp the footer timestamp + asset version on commits that touch
# the site shell or its assets. Data-only commits (e.g. YouTube refresh)
# pass through untouched so we don't needlessly bust the asset cache.
#
# IMPORTANT: time MUST come from PowerShell (the Windows clock), never the
# Git Bash `date`, which runs in UTC and silently returns the wrong day.

staged=$(git diff --cached --name-only)

# Only act when the shell or hand-authored assets actually changed.
echo "$staged" | grep -Eq '^(index\.html|css/style\.css|js/app\.js|js/feedback(-config)?\.js)$' || exit 0

ts=$(powershell.exe -NoProfile -Command "Get-Date -Format 'MMMM d, yyyy, h:mm tt'" | tr -d '\r')
ver=$(powershell.exe -NoProfile -Command "Get-Date -Format 'yyyyMMdd'" | tr -d '\r')
abbr=$(powershell.exe -NoProfile -Command "if((Get-Date).IsDaylightSavingTime()){'PDT'}else{'PST'}" | tr -d '\r')

if [ -z "$ts" ] || [ -z "$ver" ] || [ -z "$abbr" ]; then
  echo "pre-commit: could not read time from PowerShell; aborting commit." >&2
  exit 1
fi

# Second+ release on the same day: 20260925 -> 20260925b -> 20260925c ...
cur=$(grep -oE 'js/app\.js\?v=[0-9A-Za-z]+' index.html | head -1 | sed 's/.*v=//')
case "$cur" in
  "$ver")  ver="${ver}b" ;;
  "$ver"?) ver="${ver}$(printf '%s' "${cur#"$ver"}" | tr 'a-y' 'b-z')" ;;
esac

# Rewrite footer timestamp (homepage only).
sed -E -i -e "s|(Last updated: ).*P[DS]T|\1${ts} ${abbr}|" index.html

# Version the hand-authored assets on every live page (homepage, articles,
# privacy, admin), adding ?v= where missing, so no browser keeps a stale copy.
# pdf.min.js / pdf.worker.min.js are vendored and intentionally left alone;
# archived v1-v4 snapshots and india.html are not touched.
pages=$(ls index.html privacy/index.html admin/index.html 2>/dev/null; find articles -name index.html 2>/dev/null)
sed -E -i \
  -e "s#(css/style\.css|js/app\.js|js/feedback\.js|js/feedback-config\.js)(\?v=[0-9A-Za-z]+)?\"#\1?v=${ver}\"#g" \
  $pages

git add $pages
echo "pre-commit: stamped footer '${ts} ${abbr}' and asset version '${ver}'." >&2
